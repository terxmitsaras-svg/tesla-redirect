# Where the browser finds the PLATO API (WebSocket URL is derived from it).
#   empty        -> same host as the page, port 8000 (works for localhost, LAN IPs, Tailscale)
#   same-origin  -> the page's own origin (API behind the same reverse proxy, see deploy/Caddyfile)
#   https://...  -> an explicit API URL
NEXT_PUBLIC_API_URL=
