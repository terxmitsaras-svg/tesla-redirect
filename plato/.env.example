# ---- PLATO API configuration (all variables are prefixed PLATO_) ----
# development | production
PLATO_ENV=development
# PLATO_DATABASE_URL / PLATO_REDIS_URL are set by docker-compose; for bare-metal dev the default is SQLite.

# Security — REQUIRED in production
PLATO_JWT_SECRET=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATO_ENCRYPTION_KEY=
PLATO_CORS_ORIGINS=http://localhost:3000
# comma-separated emails that get admin rights on sign-up
PLATO_ADMIN_EMAILS=

# Providers
# simulated offline provider for demos/tests; MUST be false in production
PLATO_ENABLE_MOCK_PROVIDER=true
# Allow provider/agent URLs on localhost or private networks (local Ollama, LM Studio, vLLM on a LAN).
# Leave unset: allowed in development, blocked in production (SSRF protection). Set true only for
# single-tenant self-hosted installs. (Old name PLATO_ALLOW_PRIVATE_EXTERNAL_AGENTS still works.)
PLATO_ALLOW_PRIVATE_ENDPOINTS=
# Optional platform-managed keys (used only for agents without a BYOK key, debiting usage credits)
PLATO_PLATFORM_OPENAI_KEY=
PLATO_PLATFORM_ANTHROPIC_KEY=
PLATO_PLATFORM_XAI_KEY=
PLATO_PLATFORM_GEMINI_KEY=
# Optional real prices for models without built-in pricing, USD per million tokens.
# Keys: "provider:model" (preferred) or "model", e.g. {"groq:llama-3.3-70b-versatile":[0.59,0.79]}
PLATO_MODEL_PRICING_JSON=

# Orchestration defaults (clamped by plan entitlements)
PLATO_DEFAULT_MAX_TURNS_PER_AGENT=8
PLATO_DEFAULT_MAX_AGENT_MESSAGES=30
PLATO_DEFAULT_MAX_RUN_SECONDS=600
PLATO_DEFAULT_MAX_OUTPUT_TOKENS=2048
PLATO_DEFAULT_RUN_BUDGET_USD=2.0

# Stripe (optional — billing endpoints return 503 until configured)
PLATO_STRIPE_SECRET_KEY=
PLATO_STRIPE_WEBHOOK_SECRET=
PLATO_STRIPE_METER_EVENT_NAME=
PLATO_PUBLIC_APP_URL=http://localhost:3000
