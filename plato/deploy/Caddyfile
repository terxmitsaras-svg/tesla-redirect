# PLATO behind one HTTPS address (recommended for phones and anything beyond localhost).
#
#   PLATO_SITE=plato.example.com caddy run --config deploy/Caddyfile
#
# With a real domain pointing at this machine, Caddy obtains a trusted certificate automatically.
# For a LAN-only setup use e.g. PLATO_SITE="192.168.1.20" and add `tls internal` below (devices must
# then trust Caddy's local CA), or use Tailscale's HTTPS certificates.
#
# Build the web app for this mode so it calls the API on the same origin:
#   NEXT_PUBLIC_API_URL=same-origin npm run build   (in plato/frontend)
{$PLATO_SITE:localhost} {
	encode zstd gzip

	# API and WebSockets -> FastAPI
	@api path /api/* /ws/*
	reverse_proxy @api 127.0.0.1:8000

	# Everything else -> Next.js web app
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
